/*Este programa pide un número entero y muestra su factorial*/

#include<stdio.h>

int main(void){
	int numero;
	int factorial = 1;
	int i;
	printf("Introduce un número par: ");
	scanf("%d",&numero);
	if(numero % 2 == 0){
	
	for(i=1; i< numero+1; i++){
		factorial *= i;
	}
	printf("%d! = %d", numero, factorial);
	return 0;
	}else{
		printf("Ese número no es par");
	}
}
